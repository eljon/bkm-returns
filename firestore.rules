rules_version = '2';

// Security rules for the BKM Returns app.
//
// The web app writes to the `returns` collection with NO authentication, so
// these rules are intentionally permissive but constrained: they validate the
// shape of each document and forbid editing or deleting existing records.
//
// IMPORTANT: open create access means anyone with your web app URL (and the
// public Firebase config) can add returns. That is usually fine for an
// internal tool, but if you need real protection, add Firebase Authentication
// and tighten the `create` condition to `request.auth != null`.
service cloud.firestore {
  match /databases/{database}/documents {

    match /returns/{id} {
      // Anyone can read the recent-returns list.
      allow read: if true;

      // Allow creating a well-formed return.
      allow create: if isValidReturn(request.resource.data);

      // Records are immutable once written.
      allow update, delete: if false;
    }

    // Running sequence used to number transactions (R-0001, R-0002, …).
    // Anyone may read it and bump it by exactly one; it can't be deleted or
    // jumped, which keeps the numbers gap-free and tamper-resistant.
    match /counters/returns {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['current'])
        && request.resource.data.current == 1;
      allow update: if request.resource.data.keys().hasOnly(['current'])
        && request.resource.data.current is int
        && request.resource.data.current == resource.data.current + 1;
      allow delete: if false;
    }

    // Name suggestion lists (customers, items, suppliers) built up as people
    // type new values. Read by everyone; new names may be added but not edited
    // or removed. Same shape for all three collections.
    match /customers/{id} { allow read: if true; allow create: if isValidName(request.resource.data); allow update, delete: if false; }
    match /items/{id}     { allow read: if true; allow create: if isValidName(request.resource.data); allow update, delete: if false; }
    match /suppliers/{id} { allow read: if true; allow create: if isValidName(request.resource.data); allow update, delete: if false; }

    // Everything else is denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }

  function isValidReturn(data) {
    return data.txnNo is string
      && data.txnNo.size() > 0
      && data.seq is int
      && data.seq >= 1
      && data.date is string
      && data.date.size() > 0
      && data.customer is string
      && data.customer.size() > 0
      && data.item is string
      && data.item.size() > 0
      && data.supplier is string
      && data.supplier.size() > 0
      && data.condition in ['Good', 'Defective']
      && data.qty is int
      && data.qty >= 1
      && data.drNumber is string
      && data.createdAt == request.time;
  }

  function isValidName(data) {
    return data.keys().hasOnly(['name', 'createdAt'])
      && data.name is string
      && data.name.size() > 0
      && data.name.size() <= 120
      && data.createdAt == request.time;
  }
}
